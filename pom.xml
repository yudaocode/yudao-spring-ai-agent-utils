<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cn.iocoder.spring-ai</groupId>
    <artifactId>spring-ai-agent-utils-parent</artifactId>
    <version>2.1.1-jdk8-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Yudao Spring AI Agent Utils for Java 8</name>
    <url>https://github.com/yudaocode/yudao-spring-ai-agent-utils</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <modules>
        <module>spring-ai-agent-utils-common</module>
        <module>spring-ai-agent-utils</module>
        <module>exec-backends/spring-ai-agent-utils-docker-cli</module>
        <module>spring-ai-agent-utils-bom</module>
    </modules>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.1.0-jdk8-preview-20261119</spring-ai.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.spring-ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- Generated record constructors retain Boot 2's ConstructorBinding annotation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.build.directory}/generated-sources/java8</sourceDirectory>
        <testSourceDirectory>${project.build.directory}/generated-test-sources/java8</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <dependencies>
                    <dependency>
                        <groupId>com.github.javaparser</groupId>
                        <artifactId>javaparser-core</artifactId>
                        <version>3.28.2</version>
                    </dependency>
                    <dependency>
                        <groupId>com.github.javaparser</groupId>
                        <artifactId>javaparser-symbol-solver-core</artifactId>
                        <version>3.28.2</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>java8-main-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--source</argument>
                                <argument>17</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>${maven.multiModuleProjectDirectory}/compatibility/java8/Java8SourceGenerator.java</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.directory}/generated-sources/java8</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>java8-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--source</argument>
                                <argument>17</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>${maven.multiModuleProjectDirectory}/compatibility/java8/Java8SourceGenerator.java</argument>
                                <argument>${project.basedir}/src/test/java8</argument>
                                <argument>${project.build.directory}/generated-test-sources/java8</argument>
                            </arguments>
                        <skip>${maven.test.skip}</skip></configuration>
                    </execution>
                </executions>
                <configuration>
                    <includePluginDependencies>true</includePluginDependencies>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>8</release>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-XDstringConcat=inline</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.bsideup.jabel</groupId>
                            <artifactId>jabel-javac-plugin</artifactId>
                            <version>1.0.0</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <jvm>${compat.test.jvm}</jvm>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
